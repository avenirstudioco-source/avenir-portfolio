# Copiá este archivo como referencia. Los valores de acá son de ejemplo,
# no son credenciales reales.

# Connection string de tu base MySQL (Aiven, Railway, Clever Cloud, RDS, etc.)
DATABASE_URL="mysql://usuario:password@host:3306/avenir_studio"

# Secreto para firmar la cookie de sesión del panel admin.
# Generalo una vez con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="reemplazar-por-un-secreto-aleatorio-largo"

# ADMIN_EMAIL y ADMIN_PASSWORD NO van en .env — van en .env.local (gitignored).
# Ver .env.local para completar tus credenciales reales de administrador.
